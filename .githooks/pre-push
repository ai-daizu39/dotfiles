#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
scanner="$repo_root/scripts/check-public-repo.py"
remote_name="${1:-}"
checked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  printf 'Checking outgoing commits for %s -> %s...\n' "$local_ref" "$remote_ref"
  scanner_args=(--local-sha "$local_sha" --remote-sha "$remote_sha")
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ] \
    && [ -n "$remote_name" ] \
    && git remote get-url "$remote_name" >/dev/null 2>&1; then
    scanner_args+=(--remote-name "$remote_name")
  fi
  python3 "$scanner" "${scanner_args[@]}"
  checked=1
done

if [ "$checked" -eq 0 ]; then
  printf 'No commits need public-repository inspection.\n'
  exit 0
fi

if command -v gitleaks >/dev/null 2>&1 && gitleaks git --help >/dev/null 2>&1; then
  printf 'Running Gitleaks against repository history...\n'
  gitleaks git --redact --no-banner "$repo_root"
else
  printf 'Gitleaks is not installed; custom pre-push checks completed.\n' >&2
fi

# GUI applications can set DISPLAY explicitly when needed.
# Example: export DISPLAY=192.168.0.2:0.0

# Start tmux automatically only for an interactive terminal.
# Avoid taking over non-interactive SSH commands, scp/rsync, and automation.
if command -v tmux >/dev/null 2>&1 \
  && [ -z "${TMUX:-}" ] \
  && [ -t 0 ] \
  && [ -t 1 ]; then
  exec tmux
fi

# Show MOTD once in the first tmux pane.
if [ -n "${TMUX:-}" ] && [ "${TMUX_PANE:-}" = "%0" ] \
  && command -v run-parts >/dev/null 2>&1 \
  && [ -d /etc/update-motd.d ]; then
  run-parts --lsbsysinit /etc/update-motd.d
fi
